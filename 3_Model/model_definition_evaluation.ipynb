    "TARGET = f\"target_binary_{HORIZON}\"\n",
    "TARGET_END = f\"target_end_time_{HORIZON}\"\n",
    "TASK_DATA_PATH = Path(os.environ.get(\n",
    "    \"BTC_TASK_DATA_PATH\",\n",
    "    f\"data/modeling/tasks/BTCUSDT_15m_binary_h{HORIZON}.parquet\",\n",
    "))\n",
    "\n",
    "def load_model_data(path: Path) -> pd.DataFrame:\n",
    "    frame = pd.read_parquet(path) if path.suffix.lower() in {\".parquet\", \".pq\"} else pd.read_csv(path)\n",
    "    frame[\"open_time\"] = pd.to_datetime(frame[\"open_time\"], utc=True)\n",
    "    if TARGET_END in frame:\n",
    "        frame[TARGET_END] = pd.to_datetime(frame[TARGET_END], utc=True)\n",
    "    return frame.sort_values(\"open_time\").reset_index(drop=True)\n",
    "\n",
    "def select_features(frame: pd.DataFrame) -> list[str]:\n",
    "    blocked = {\"symbol\", \"interval\", \"open_time\", TARGET, TARGET_END}\n",
    "    return [\n",
    "        column for column in frame.select_dtypes(include=np.number).columns\n",
    "        if column not in blocked\n",
    "        and not column.lower().startswith(\"target_\")\n",
    "        and \"future\" not in column.lower()\n",
    "    ]\n",
    "\n",
    "if TASK_DATA_PATH.is_file():\n",
    "    data = load_model_data(TASK_DATA_PATH)\n",
    "    FEATURES = select_features(data)\n",
    "    development = data[data[\"open_time\"] < \"2025-01-01\"].copy()\n",
    "    reserved_test = data[data[\"open_time\"] >= \"2025-01-02\"].copy()\n",
    "    print(f\"Development rows: {len(development):,}; features: {len(FEATURES)}\")\n",
    "    print(f\"Reserved test rows (not evaluated): {len(reserved_test):,}\")\n",
    "else:\n",
