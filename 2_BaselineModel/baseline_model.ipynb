    "def load_task_table(path: Path) -> pd.DataFrame:\n",
    "    frame = pd.read_parquet(path) if path.suffix.lower() in {\".parquet\", \".pq\"} else pd.read_csv(path)\n",
    "    frame[\"open_time\"] = pd.to_datetime(frame[\"open_time\"], utc=True)\n",
    "    if TARGET_END in frame:\n",
    "        frame[TARGET_END] = pd.to_datetime(frame[TARGET_END], utc=True)\n",
    "    return frame.sort_values(\"open_time\").reset_index(drop=True)\n",
    "\n",
    "def feature_columns(frame: pd.DataFrame) -> list[str]:\n",
    "    blocked = {\"symbol\", \"interval\", \"open_time\", TARGET, TARGET_END}\n",
    "    columns = []\n",
    "    for column in frame.select_dtypes(include=np.number).columns:\n",
    "        lowered = column.lower()\n",
    "        if column not in blocked and not lowered.startswith(\"target_\") and \"future\" not in lowered:\n",
    "            columns.append(column)\n",
    "    return columns\n",
    "\n",
    "if TASK_DATA_PATH.is_file():\n",
    "    data = load_task_table(TASK_DATA_PATH)\n",
    "    FEATURES = feature_columns(data)\n",
    "\n",
    "    train = data[data[\"open_time\"] < \"2024-01-01\"].copy()\n",
    "    validation = data[\n",
    "        (data[\"open_time\"] >= \"2024-01-02\") &\n",
    "        (data[\"open_time\"] < \"2025-01-01\")\n",
    "    ].copy()\n",
